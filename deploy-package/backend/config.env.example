# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OSS路径前缀（可选）
# 留空则直接存储到桶根目录，设置后会在所有文件路径前添加此前缀
# 例如：OSS_PATH_PREFIX=knowledge-base/ 或 OSS_PATH_PREFIX=uploads/
# 默认值：knowledge-base/
OSS_PATH_PREFIX=knowledge-base/

# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/official-website

# JWT配置
JWT_SECRET=your_jwt_secret_key_here

# CORS配置 - 支持多个前端域名
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key

# 清理任务配置
CLEANUP_ENABLED=true
TEMP_FILE_RETENTION_DAYS=7
DELETED_RECORD_RETENTION_DAYS=30

# 后台一键更新前自动备份（生产环境建议开启）
UPDATE_BACKUP_ENABLED=true
UPDATE_BACKUP_REQUIRED=true
UPDATE_BACKUP_DIR=/var/backups/carradioweb
UPDATE_BACKUP_RETENTION_COUNT=7
# 可选路径与容器参数，详见项目根目录 backend/config.env.example
# UPDATE_UPLOADS_PATH=/var/lib/carradioweb/uploads
# UPDATE_MONGO_CONTAINER=automotivehu-mongo
# UPDATE_MONGO_DATABASE=knowledge-base
# UPDATE_MONGO_USERNAME=admin
# UPDATE_MONGO_PASSWORD=
# UPDATE_FLARUM_DB_CONTAINER=flarum_db
# UPDATE_FLARUM_DB_NAME=flarum
# UPDATE_FLARUM_DB_USER=flarum
# UPDATE_FLARUM_DB_PASSWORD=
# UPDATE_FLARUM_DUMP_COMMAND=mariadb-dump
# UPDATE_FLARUM_CONTAINER=flarum_app
# UPDATE_FLARUM_DATA_PATH=
