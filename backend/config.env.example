# 阿里云OSS配置
OSS_ACCESS_KEY_ID=your-oss-access-key-id-here
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret-here
OSS_BUCKET=your-bucket-name
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 服务器配置
PORT=3000
NODE_ENV=production

# CORS配置 - 支持生产环境和本地开发
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:4173,http://automotivehu.com,https://automotivehu.com,http://www.automotivehu.com,https://www.automotivehu.com

# JWT密钥（生产环境必须配置，至少32字符，不要使用示例值！）
# 生成方法：openssl rand -hex 32
JWT_SECRET=change-this-to-your-secure-jwt-key-in-production

# 数据加密密钥（用于加密存储敏感信息如 API 密钥）
# 生成方法：openssl rand -hex 32
# 生产环境必须配置！
ENCRYPTION_KEY=

# OpenAI API配置
OPENAI_API_KEY=your-openai-api-key-here

# 钉钉机器人配置（表单提交通知）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token-here
DINGTALK_SECRET=your-secret-here

# ==================== 新增：优化工具配置 ====================

# Redis 缓存配置（可选，不配置则使用内存缓存）
# REDIS_URL=redis://localhost:6379

# Sentry 错误监控配置（可选）
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# 应用版本号（用于 Sentry 版本追踪）
APP_VERSION=1.0.0

# ==================== OAuth 认证配置（已弃用） ====================
# 以下 OAuth 配置已不再使用，保留仅供参考

# Google OAuth（从 Google Cloud Console 获取）
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth（从 GitHub Developer Settings 获取）
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth 回调基础 URL（生产环境填写实际域名）
# OAUTH_CALLBACK_BASE=http://localhost:3000

# ==================== SMTP 邮箱配置（用于验证码发送） ====================
# 支持：网易163/126、QQ邮箱、Gmail、Outlook、阿里企业邮箱等
# 注意：网易和QQ邮箱需要使用授权码而非登录密码

# SMTP 服务器地址
SMTP_HOST=
# SMTP 端口（SSL通常为465，TLS通常为587）
SMTP_PORT=465
# 是否使用 SSL（465端口通常为true）
SMTP_SECURE=true
# SMTP 用户名（通常是邮箱地址）
SMTP_USER=
# SMTP 密码或授权码
SMTP_PASS=
# 发件人地址（默认使用 SMTP_USER）
SMTP_FROM=

# 前端 URL（OAuth 登录成功后重定向目标）
FRONTEND_URL=http://localhost:3001
# Optional production parent domain shared by www, apex, and forum OAuth flows.
# AUTH_COOKIE_DOMAIN=.example.com

# Flarum FoF Passport OAuth 2.0 client. The client ID/secret and redirect URI
# must match the FoF Passport settings in the forum administration panel.
# FORUM_BASE_URL=http://localhost:8888
# FORUM_OAUTH_CLIENT_ID=carradioweb-forum
# FORUM_OAUTH_CLIENT_SECRET=generate-a-random-secret-at-least-32-characters
# FORUM_OAUTH_REDIRECT_URI=http://localhost:8888/auth/passport
# Comma-separated forum administrator emails that must never be linked by SSO.
# FORUM_SSO_BLOCKED_EMAILS=admin@example.com

# ==================== HTTP 代理（可选） ====================
# 国内开发环境需要代理才能访问 Google/GitHub OAuth 服务
# 取消注释并填写你的本地代理地址，常见端口：7890/7897/1080/10809
# 生产环境（海外服务器）不需要配置此项
# HTTPS_PROXY=http://127.0.0.1:7890

# ==================== Admin one-click project updates ====================
# Enabled by default in production. Set false to disable the update action.
SELF_UPDATE_ENABLED=true
# GitHub branch used by the update checker.
UPDATE_BRANCH=main
# Required when the GitHub repository is private. Use a fine-grained token
# with read-only Contents access; never commit the real token to this file.
# UPDATE_GITHUB_TOKEN=
# Must match the PM2 application name in ecosystem.config.cjs.
PM2_PROCESS_NAME=official-backend
# Optional separate frontend process. Leave empty when frontend assets are
# served by the backend or by nginx.
# FRONTEND_PM2_PROCESS_NAME=official-frontend

# ==================== 更新前自动数据备份 ====================
# 生产环境默认开启；开发环境默认关闭。备份失败默认会阻止更新。
UPDATE_BACKUP_ENABLED=true
UPDATE_BACKUP_REQUIRED=true
# 必须指向重启/容器重建后仍保留的磁盘目录，例如独立挂载盘。
UPDATE_BACKUP_DIR=/var/backups/carradioweb
UPDATE_BACKUP_RETENTION_COUNT=7
# 主站上传目录；默认是项目根目录/backend/uploads。
# UPDATE_UPLOADS_PATH=/var/lib/carradioweb/uploads
# 若更新器所在环境安装了 mongodump，可直接使用 MONGODB_URI。
# MONGODB_URI=mongodb://user:password@127.0.0.1:27017/knowledge-base?authSource=admin
# 若只能通过 Docker 导出，填写容器名及数据库参数；密码不会写入更新日志。
# UPDATE_DOCKER_COMMAND=docker
# UPDATE_MONGO_CONTAINER=automotivehu-mongo
# UPDATE_MONGO_DATABASE=knowledge-base
# UPDATE_MONGO_USERNAME=admin
# UPDATE_MONGO_PASSWORD=
# Flarum 数据库导出参数。优先使用本机 mariadb-dump/mysqldump。
# UPDATE_FLARUM_DB_HOST=127.0.0.1
# UPDATE_FLARUM_DB_PORT=3306
# UPDATE_FLARUM_DB_NAME=flarum
# UPDATE_FLARUM_DB_USER=flarum
# UPDATE_FLARUM_DB_PASSWORD=
# 容器环境可改为 flarum_db，并配置数据库容器名作为备用导出方式。
# UPDATE_FLARUM_DB_CONTAINER=flarum_db
# UPDATE_FLARUM_DUMP_COMMAND=mariadb-dump
# 可选：Flarum /data 在宿主机上的持久化路径；未配置时尝试 docker cp。
# UPDATE_FLARUM_DATA_PATH=/var/lib/docker/volumes/flarum_data/_data
# UPDATE_FLARUM_CONTAINER=flarum_app
