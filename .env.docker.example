# Docker Compose 环境变量
# 复制此文件为 .env 并填入实际值

# MongoDB 配置
MONGO_USERNAME=admin
MONGO_PASSWORD=your_secure_password_here
MONGO_DATABASE=carradioweb
MONGODB_URI=mongodb://admin:your_secure_password_here@mongo:27017/carradioweb?authSource=admin

# JWT 密钥
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters

# 阿里云 OSS 配置
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# Local SMTP capture for verification codes.
# Docker Compose includes Mailpit; open http://127.0.0.1:8025 to view emails.
# For real email delivery, replace these with any SMTP provider values.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost

# 后台一键更新：生产环境默认在更新前备份数据，备份失败会中止更新。
UPDATE_BACKUP_ENABLED=true
UPDATE_BACKUP_REQUIRED=true
UPDATE_BACKUP_DIR=/var/backups/carradioweb
UPDATE_BACKUP_RETENTION_COUNT=7
# 更新器所在容器/主机必须安装 mongodump、mariadb-dump，或提供可用的 Docker CLI。
# UPDATE_DOCKER_COMMAND=docker
# 正常情况下无需填写，更新器读取 MONGODB_URI；仅在驱动备份不可用时覆盖。
# UPDATE_MONGO_CONTAINER=caradio-mongo
# UPDATE_MONGO_DATABASE=carradioweb
# UPDATE_MONGO_USERNAME=admin
# UPDATE_MONGO_PASSWORD=
# Flarum 参数默认从项目根目录 .env.flarum 读取；仅在特殊部署中覆盖。
# UPDATE_FLARUM_DB_CONTAINER=
# UPDATE_FLARUM_DB_NAME=
# UPDATE_FLARUM_DB_USER=
# UPDATE_FLARUM_DB_PASSWORD=
# UPDATE_FLARUM_DUMP_COMMAND=mariadb-dump
# UPDATE_FLARUM_CONTAINER=
# UPDATE_FLARUM_DATA_PATH=
# UPDATE_UPLOADS_PATH=/app/uploads
